{
  "name": "pages-mcp-server",
  "version": "1.0.0",
  "description": "Self-hosted MCP server for deploying and managing static websites",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "ptbsare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptbsare/pages-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ptbsare/pages-mcp-server/issues"
  },
  "homepage": "https://github.com/ptbsare/pages-mcp-server#readme",
  "keywords": [
    "mcp",
    "static-site",
    "deploy",
    "edgeone",
    "pages",
    "model-context-protocol"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "pages-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./client": "./dist/client/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev:server": "tsx server/index.ts",
    "dev:client": "tsx client/src/cli.ts",
    "docker:build": "docker build -t pages-mcp-server .",
    "docker:run": "docker run -p 3000:3000 pages-mcp-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "adm-zip": "^0.5.16",
    "basic-auth": "^2.0.1",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "nanoid": "^5.1.5",
    "qrcode": "^1.5.4",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/basic-auth": "^1.1.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
