[Unit]
Description=Pages MCP Server
After=network.target
Wants=network-online.target

[Service]
Type=simple

# SECURITY: Run as non-root user if possible
# Create user: useradd --system --no-create-home --shell /usr/sbin/nologin pages-mcp
# Then uncomment below and comment out User=root:
# User=pages-mcp
# Group=pages-mcp
User=root
Group=root

ExecStart=/usr/bin/npx -y github:ptbsare/pages-mcp-server server --port 3000 --domain http://localhost:3000 --admin-user admin --admin-pass changeme

Environment=PORT=3000
Environment=DOMAIN=http://localhost:3000
Environment=ADMIN_USERNAME=admin
Environment=ADMIN_PASSWORD=changeme
# Store data outside /root when running as non-root:
# Environment=DB_PATH=/var/lib/pages-mcp/pages.db
# Environment=STORAGE_PATH=/var/lib/pages-mcp/storage
Environment=DB_PATH=/root/.pages-mcp/pages.db
Environment=STORAGE_PATH=/root/.pages-mcp/storage

Restart=on-failure
RestartSec=10

# Hardening (enable when running as non-root):
# NoNewPrivileges=true
# ProtectSystem=strict
# ProtectHome=true
# PrivateTmp=true
# ReadWritePaths=/var/lib/pages-mcp

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pages-mcp-server

[Install]
WantedBy=multi-user.target
